# Root template for values shared across the Docker Compose stack.
# Per-app templates live in apps/api/.env.example and apps/worker/.env.example
# and apps/web/.env.example — copy each to .env for local (non-Docker) development.

POSTGRES_USER=gpu
POSTGRES_PASSWORD=gpu
POSTGRES_DB=gpu_platform
POSTGRES_PORT=5432

REDIS_PORT=6379

API_PORT=4000
WEB_PORT=5173
