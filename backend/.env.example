# ─── Backend .env.example ─────────────────────────────────────────────────────
# Copy this to .env and fill in real values. NEVER commit .env to git.
# Generate JWT_SECRET with: openssl rand -hex 32

MONGODB_URI=mongodb://localhost:27017/pbl-gpu-manager

# REQUIRED — generate with: openssl rand -hex 32
JWT_SECRET=replace_with_output_of__openssl_rand_-hex_32

JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

PORT=5001

NODE_ENV=development

ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80,https://your-app.vercel.app
