# Template for docker-compose.prod.yml. Copy to .env.prod, fill in real
# values, and never commit the result:
#   cp .env.prod.example .env.prod
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
#
# Every secret below has NO default in docker-compose.prod.yml — the stack
# refuses to start with a clear error if you forget one, rather than
# silently booting with a dev-only placeholder. Generate secrets with:
#   openssl rand -hex 32

# --- Public origin --------------------------------------------------------
# The externally-reachable origin browsers load the app from (used for
# CORS). Must match exactly, including scheme — no trailing slash.
PUBLIC_ORIGIN=https://gpu.example.edu

# Host port nginx (the single ingress) publishes. Put a TLS-terminating
# load balancer or reverse proxy in front of this in real deployments — see
# docs/deployment.md.
HTTP_PORT=80

# --- Postgres ---------------------------------------------------------
POSTGRES_USER=gpu_prod
POSTGRES_PASSWORD=
POSTGRES_DB=gpu_platform

# --- Auth (Phase 3) --------------------------------------------------------
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_PEPPER=
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_SALT_ROUNDS=12
# Leave unset for a host-only cookie, or set to your apex domain (e.g.
# ".example.edu") to share the session across subdomains.
COOKIE_DOMAIN=
# Whether auth cookies get the `Secure` attribute (requires HTTPS to be
# sent/stored by the browser). Defaults to true (NODE_ENV=production) —
# leave unset for a real deployment behind TLS. Set to false only to run
# this production topology locally over plain HTTP (e.g. http://localhost
# with no TLS-terminating proxy in front); Safari, unlike Chromium, refuses
# Secure cookies over HTTP even for localhost and every authenticated
# request 401s otherwise.
COOKIE_SECURE=

# --- Telemetry (Phase 5) ----------------------------------------------------
TELEMETRY_INGEST_TOKEN=
TELEMETRY_ONLINE_THRESHOLD_SECONDS=30
TELEMETRY_DEGRADED_THRESHOLD_SECONDS=90

# --- Observability (Phase 10) ----------------------------------------------
# One of: fatal, error, warn, info, debug, trace, silent.
LOG_LEVEL=info
