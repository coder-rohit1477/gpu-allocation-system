{
  "name": "@gpu/types",
  "version": "0.1.0",
  "private": true,
  "description": "Shared TypeScript types and contracts used across apps",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
