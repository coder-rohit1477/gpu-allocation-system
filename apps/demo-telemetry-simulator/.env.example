# Copy to .env for `pnpm --filter @gpu/demo-telemetry-simulator dev` against
# a locally running API. DEV/DEMO ONLY — see README's "Demo environment"
# section. In Docker, all of these are supplied by docker-compose.demo.yml
# instead.

# Must match the API's TELEMETRY_INGEST_TOKEN exactly.
TELEMETRY_INGEST_TOKEN=dev-only-change-me-telemetry-token

# Where the API is reachable from wherever this process runs.
DEMO_SIMULATOR_API_BASE_URL=http://localhost:4000

# How often (ms) each simulated node sends telemetry. Keep this comfortably
# below the API's TELEMETRY_ONLINE_THRESHOLD_SECONDS (default 30s).
DEMO_SIMULATOR_HEARTBEAT_INTERVAL_MS=10000

# Simulated node topology — must mirror apps/api/prisma/seed.ts's GPU nodes
# (department codes, lowercase, and nodes per department) for hostnames to
# match seeded nodes exactly.
DEMO_SIMULATOR_DEPARTMENTS=cse,ai,ds
DEMO_SIMULATOR_NODES_PER_DEPARTMENT=4
DEMO_SIMULATOR_HOSTNAME_SUFFIX=.muj.local
