# Copy to .env and fill in values for local development.

NODE_ENV=development
PORT=4000

# PostgreSQL connection string used by Prisma
DATABASE_URL=postgresql://gpu:gpu@localhost:5432/gpu_platform?schema=public

# Redis connection string, shared with the worker
REDIS_URL=redis://localhost:6379

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# --- Auth (Phase 3) -----------------------------------------------------
# Generate strong random values for these in every real environment, e.g.:
#   openssl rand -hex 32

# Signing secret for short-lived access tokens (never sent to the client as a cookie value — only the signed JWT is).
JWT_ACCESS_SECRET=dev-only-change-me-access-secret
JWT_ACCESS_TTL_MINUTES=15

# HMAC key used to hash opaque refresh tokens before they are stored — the raw token itself is never persisted.
REFRESH_TOKEN_PEPPER=dev-only-change-me-refresh-pepper
REFRESH_TOKEN_TTL_DAYS=7

BCRYPT_SALT_ROUNDS=12

# Optional cookie Domain attribute (leave unset for host-only cookies in local dev).
# COOKIE_DOMAIN=

# --- Telemetry (Phase 5) -------------------------------------------------
# Shared secret GPU node agents must send as the X-Telemetry-Token header on
# POST /telemetry/heartbeat and /telemetry/metrics. Generate with:
#   openssl rand -hex 32
TELEMETRY_INGEST_TOKEN=dev-only-change-me-telemetry-token

# Heartbeat-age thresholds (seconds) for the derived ONLINE/DEGRADED/OFFLINE
# health status: < online = ONLINE, online..degraded = DEGRADED, > degraded = OFFLINE.
TELEMETRY_ONLINE_THRESHOLD_SECONDS=30
TELEMETRY_DEGRADED_THRESHOLD_SECONDS=90
